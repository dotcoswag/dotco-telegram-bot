# Required — Telegram bot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_from_botfather

# Required — RapidAPI for the Google Maps lead scraper
RAPIDAPI_KEY=your_rapidapi_key_here

# Optional — Claude AI enrichment. Leave empty to disable /enrich (default-off).
ANTHROPIC_API_KEY=

# Webhook — public HTTPS base URL where Telegram will POST updates.
# Local dev: use ngrok or similar. Production: https://<service>.onrender.com
WEBHOOK_BASE_URL=https://your-service.onrender.com

# Webhook secret — Telegram echoes this back in a header so we can reject spoofed POSTs.
# Render's render.yaml generates this automatically. For local dev, set any random string.
WEBHOOK_SECRET_TOKEN=change_me_to_a_random_string

# Port the bot listens on. Render injects $PORT automatically; locally default to 10000.
PORT=10000
